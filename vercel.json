{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/v1/apps",
      "destination": "/api/apps"
    },
    {
      "source": "/v1/apps/:slug",
      "destination": "/api/apps/detail?slug=:slug"
    }
  ]
}
