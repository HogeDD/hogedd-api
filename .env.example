# Non-secret local defaults. Do not put credentials in this file.
APP_ENV=development
LOG_LEVEL=debug
PORT=8080

# Use Neon's pooled URL at runtime and direct URL only for migrations.
DATABASE_URL=postgresql://user:password@pooler.example.invalid/hogedd?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@direct.example.invalid/hogedd?sslmode=require
# Optional override when the migration target differs from DATABASE_URL_UNPOOLED.
DATABASE_MIGRATION_URL=
DATABASE_MAX_OPEN_CONNS=5
DATABASE_MAX_IDLE_CONNS=2
